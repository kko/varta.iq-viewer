{
  "platform": { "apiRuntime": "node:22" },
  "routes": [
    { "route": "/.auth/*", "allowedRoles": ["anonymous"] },
    { "route": "/api/ingest", "methods": ["POST"], "allowedRoles": ["anonymous"] },
    { "route": "/api/*", "allowedRoles": ["viewer"] },
    { "route": "/access.html", "allowedRoles": ["anonymous"] },
    { "route": "/*", "allowedRoles": ["viewer"] }
  ],
  "responseOverrides": { "401": { "redirect": "/.auth/login/aad?post_login_redirect_uri=/", "statusCode": 302 }, "403": { "rewrite": "/access.html" } },
  "globalHeaders": { "X-Content-Type-Options": "nosniff", "Referrer-Policy": "no-referrer", "Content-Security-Policy": "default-src 'self'; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" }
}
